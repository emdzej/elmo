{
  // elmo docs lint config. Structural rules on; prose line-length off.
  "default": true,
  "MD013": false, // line-length: prose wraps naturally; hard 80-col hurts diffs
  "MD024": { "siblings_only": true }, // allow repeated headings under different parents
  "MD033": false, // allow inline HTML (needed for some rendered examples)
  "MD041": false  // first line need not be a top-level heading
}
