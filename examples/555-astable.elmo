title "555 astable"

part U1 ic "NE555" pkg=DIP-8 {
  left  2:TRIG  6:THRES  7:DISCH
  right 3:OUT   4:~RESET
  top   8:VCC
  bottom 1:GND
}
part R1 res 10k
part R2 res 47k
part C1 cap 10n

power VCC = U1.VCC U1.~RESET R1.1
gnd   GND = U1.GND C1.2

net disch  = U1.DISCH R1.2 R2.1        as=wire
net timing = U1.THRES U1.TRIG R2.2 C1.1 as=wire
